{
  "expo": {
    "name": "pSalmo",
    "slug": "psalmo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [],
          "disableFFmpeg": true
        }
      ],
      "./plugins/withWindowsAudioBuild"
    ],
    "android": {
      "package": "com.paw.psalmo",
      "predictiveBackGestureEnabled": false
    },
    "ios": { "bundleIdentifier": "com.paw.psalmo" }
  }
}
