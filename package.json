{
  "name": "psalmo",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:go": "expo start --go",
    "generate:android": "expo prebuild --platform android --no-install",
    "build:android": "powershell -NoProfile -File scripts/build-android.ps1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc src/domain/calendar.ts src/domain/youtube.ts src/domain/weekly.ts src/domain/metronome.ts src/domain/playback.ts --module commonjs --target es2020 --skipLibCheck --outDir .test-build && node --test --test-isolation=none tests/domain.test.cjs tests/metronome.test.cjs tests/native-build.test.cjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~54.0.0",
    "expo-crypto": "15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-audio-api": "0.12.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
